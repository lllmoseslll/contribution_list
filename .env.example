# Postgres connection string. REQUIRED.
# Pledges, settings and notifications are stored here (see lib/db.js) —
# needed because Vercel's serverless filesystem is read-only outside /tmp
# and gives no shared memory across invocations. Works with:
#   - A local Postgres for development, e.g. via Docker:
#       docker run -d -p 55432:5432 -e POSTGRES_PASSWORD=devpass -e POSTGRES_DB=kwanjula postgres:16-alpine
#       POSTGRES_URL=postgresql://postgres:devpass@localhost:55432/kwanjula
#   - Vercel Postgres / Neon or Supabase in production — copy the connection
#     string they give you verbatim (TLS is enabled automatically for any
#     non-localhost host).
# After setting this for a fresh database, run once:
#   npm run db:migrate
# to create the schema and (if data/*.json still exist) import legacy data.
POSTGRES_URL=

# Committee admin passcode. REQUIRED.
# There is no default and no fallback: with this unset, every /api/admin/*
# route authenticates nobody and says which variable is missing.
ADMIN_PIN=

# Signing key for the admin session cookie. REQUIRED.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating this invalidates every issued session.
ADMIN_SESSION_SECRET=

# Fallback recipient for pledge alert emails. Used only when no recipient is
# set in the admin portal's Settings tab (which writes to the Postgres
# settings table).
OWNER_EMAIL=

# SMTP delivery is configured in the admin portal's Settings tab and stored in
# the Postgres settings table — not here. This file previously listed
# SMTP_ENABLED, SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASS and
# SMTP_FROM; none of them were ever read (lib/mailer.js builds its transport
# from settings.smtp), so they are removed rather than left as false
# documentation.

# Read only by the legacy Express server (npm run server-legacy). Next's own
# dev and start scripts set the port with -p in package.json.
PORT=3000
